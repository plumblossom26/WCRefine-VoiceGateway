PORT=8787
PROXY_TOKEN=replace-with-a-long-random-token
FISH_API_KEY=replace-with-server-side-key
UPSTREAM_AUTH_MODE=server
VOICE_GATEWAY_AUTH_SECRET=replace-with-a-long-random-secret
FISH_BASE_URL=https://api.fish.audio
FISH_TTS_MODEL=s2.1-pro-free
VOICE_CATALOG_URL=https://raw.githubusercontent.com/plumblossom26/WCRefine-VoiceHub/main/catalog/voices.json
CATALOG_CACHE_PATH=/data/catalog.json
# Reload local/remote catalog without restarting the gateway.
CATALOG_REFRESH_SECONDS=300
